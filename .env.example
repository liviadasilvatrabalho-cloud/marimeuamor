# ============================================================================
# Our Little Kitchen — variáveis de ambiente (modelo)
# ============================================================================
# Este arquivo NÃO contém credenciais reais.
# Os valores reais ficam em .env.local (gitignored), escrito por `neon deploy`.
# Carregado por env.ts na ordem: .env.local, depois .env.

# ----------------------------------------------------------------------------
# Banco de dados (obrigatório)
# ----------------------------------------------------------------------------

# DATABASE_URL: string de conexão Neon Postgres (pooler).
# Uso: pool do aplicativo em db.ts (driver `pg`, processo Express de longa duração).
# `neon deploy` grava o valor real em .env.local.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/db?sslmode=require"

# DATABASE_URL_UNPOOLED: conexão direta (sem pooler).
# Uso: migrations, dumps e tarefas de longa duração, que não devem passar pelo pooler.
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/db?sslmode=require"

# NEON_BRANCH / NEON_BRANCH_ID: branch do projeto Neon usada neste ambiente.
NEON_BRANCH="production"
NEON_BRANCH_ID="br-xxxxxxxxxxxx"

# ----------------------------------------------------------------------------
# Inteligência artificial (Gemini)
# ----------------------------------------------------------------------------

# GEMINI_API_KEY: necessária para as rotas de IA em server.ts:
#   POST /api/gemini/analyze-meal   — reconhecimento de refeição por foto
#   POST /api/gemini/ocr-label      — leitura de rótulo nutricional
#   POST /api/gemini/recipe-assistant— assistente de receitas
#   POST /api/gemini/read-barcode   — leitura de código de barras por imagem
# Sem esta chave as rotas respondem com erro controlado; o restante do app funciona.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ----------------------------------------------------------------------------
# Aplicação
# ----------------------------------------------------------------------------

# APP_URL: URL pública onde o app é hospedado.
# Usada em links auto-referenciais e callbacks.
APP_URL="MY_APP_URL"

# NODE_ENV: defina como "production" em produção.
# Em production: cookie de sessão ganha atributo Secure e o servidor passa a
# servir a pasta dist/ em vez do middleware do Vite.
NODE_ENV="development"

# PORT: porta do servidor Express. Padrão: 3000.
PORT="3000"

# ----------------------------------------------------------------------------
# Autenticação e perfis
# ----------------------------------------------------------------------------

# ALLOW_PROFILE_HEADER: controla o header X-Profile-ID (identificação de perfil
# em desenvolvimento/testes). Em produção o valor padrão é desativado;
# defina "false" explicitamente para garantir que fique desligado.
# O login real usa o cookie HttpOnly olk_session (login por PIN).
ALLOW_PROFILE_HEADER="true"

# SINGLE_USER_PROFILE_ID: (opcional) ID do perfil usado em modo usuário único.
# Quando definido, requisições sem sessão são atribuídas a esse perfil — útil
# para uso pessoal (ex.: só a Mari). Deixe vazio para exigir login (padrão).
# UUID da Mari: 33333333-3333-3333-3333-333333333333
SINGLE_USER_PROFILE_ID=""

# OLK_SETUP_CODE: código de configuração inicial usado no primeiro login por PIN.
# Necessário apenas na primeira execução para definir o PIN do perfil admin.
OLK_SETUP_CODE=""

# ----------------------------------------------------------------------------
# Desenvolvimento
# ----------------------------------------------------------------------------

# DISABLE_HMR: "true" desativa o HMR do Vite (útil em ambientes de preview).
DISABLE_HMR="false"
