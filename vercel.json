{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-DNS-Prefetch-Control", "value": "off" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self' data: 'unsafe-inline' https:; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; script-src 'self' 'unsafe-inline' https:; connect-src 'self' https: http:; frame-src 'none'" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/api/barcode/:code",
      "destination": "https://world.openfoodfacts.org/api/v2/product/:code.json",
      "permanent": false
    }
  ]
}
