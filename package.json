{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && npm run build:function",
    "build:function": "esbuild serverless/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=api/index.js --legal-comments=none",
    "start": "node server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx tests/run.ts",
    "test:db": "tsx tests/run.ts",
    "db:migrate": "tsx db/migrate.ts",
    "db:verify": "tsx verify-db.mjs",
    "db:inspect": "tsx db-inspect.mjs"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
